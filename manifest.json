{
  "name": "Autobing",
  "version": "1.4.3",
  "description": "Automating your Bing searches so you don't have to! (@fastdemo)",
  "manifest_version": 3,
  "action": {
    "default_popup": "index.html",
    "default_title": "Search Automator"
  },
  "permissions": ["debugger", "tabs", "alarms", "storage"],
  "icons": {
    "16": "img/icon16.png",
    "32": "img/icon32.png",
    "48": "img/icon48.png",
    "128": "img/icon128.png"
  },
  "background": {
    "service_worker": "js/background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.bing.com/*"],
      "js": ["js/content.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["img/icon128.png"],
      "matches": ["*://*.bing.com/*"]
    }
  ]
}
